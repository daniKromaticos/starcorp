# Copiar a .env y completar. Todo lo EXPO_PUBLIC_ queda dentro de la app: nunca pongas secretos de servidor aquí.
# Detalle en docs/02-setup-y-deploy.md

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Debe valer exactamente "false" para usar datos reales; cualquier otro valor (o vacío) usa mocks.
EXPO_PUBLIC_USE_MOCKS=false

# Ids de los tableros de Notion (Seguros)
EXPO_PUBLIC_NOTION_DB_SEGUROS=
EXPO_PUBLIC_NOTION_DB_LLC=

# Opcionales: sobrescriben el dataset de Power BI de Presupuesto
# EXPO_PUBLIC_PRESUPUESTO_DATASET_ID=
# EXPO_PUBLIC_PRESUPUESTO_GROUP_ID=
